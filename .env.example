# CAMPUSPHERE environment — copy to .env (never commit .env)

APP_NAME=CAMPUSPHERE
APP_ENV=development          # production hides the demo-account box on the login page
APP_KEY=                     # php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# BASE_URL=http://campusphere.test/   # optional – auto-detected when empty
# SCHOOL_NAME=Aurora National High School
# SHOW_DEMO_ACCOUNTS=false   # force the demo box off/on regardless of APP_ENV

# Database (MySQL 8 / MariaDB 10.4+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusphere
DB_CHARSET=utf8mb4
DB_PREFIX=

# Not used by CAMPUSPHERE (framework API module)
JWT_SECRET=
REFRESH_TOKEN_KEY=
